programa {
  funcao inicio() {
    inteiro nu
 escreva("Digite um número de 1 a 7: ")
leia(nu)
se(nu == 1){
  escreva("Domingo")
}
se(nu == 2){
  escreva("Segunda")
}
se(nu == 3){
  escreva("Terça")
}
se(nu == 4){
  escreva("Quarta")
}
se(nu == 5){
  escreva("Quinta")
}
se(nu == 6){
  escreva("Sexta")
}
se(nu == 7){
  escreva("Sábado")
}







  }
}
