programa {
  funcao inicio() {
    inteiro idade
    cadeia senha

    escreva("Digite sua idade: ")
    leia(idade)
  se(idade < 18){
    escreva("Você é menor de idade!")
     }senao{
     escreva("Você é maior de idade!")
}

escreva("\nEscreva uma senha: ")
leia(senha)
se(senha == "Abracadabra"){
escreva("Você descobriu coisas indevidas....")
}senao{
  escreva("Senha registrada!")
}

  }
}
