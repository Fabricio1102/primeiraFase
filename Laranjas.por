programa {
  funcao inicio() {
    // entendimento do problema
    // infos e variávies
    inteiro laranja
    escreva("Quantas laranjas você tinha no começo? ")
    leia(laranja)
    inteiro fim
    escreva("Quantas laranajas você tinha no fim do dia? ")
    leia(fim)
    inteiro final = laranja - fim
    escreva("Você tinha " + laranja + " laranjas no começo do dia, no fim do dia você vendeu " + fim + " laranjas, sobrando um total de " + final + " sobrando, infelizmente você não vendeu tudo")
    // entrada de dados
    // precessamento
    // saídas
  }
}
