programa {
  funcao inicio() {
    real salario, dias, valor, semana
    escreva("Digite quanto você recebe por mês: ")
    leia(salario)
    escreva("Quantos dias você trabalha no mês: ")
    leia(dias)
    valor = salario/dias
    semana = valor * 5  
  escreva("Você recebe " + valor + " por dia")
  escreva("\nVocê recebe " + semana + " por semana")





  }
}
