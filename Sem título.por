programa {
  funcao inicio() {
    inteiro idade
    cadeia nome
    escreva("Sua idade: ")
    leia(idade)
    escreva("Seu nome: ")
    leia(nome)
  se(idade < 18){
    escreva("Olá " + nome + " você tem " + idade + " anos, será um prazer telo conosco!")
  }
  se(idade >= 18){
    escreva("Vaza!")

  }
se(nome == "Rafael"){
  escreva("\nVocê pode entrar escondido...")
}

se(nome != "Rafael"){
  escreva("\nVocê não aparece nos créditos.")
}





  }
}
