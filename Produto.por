programa {
  funcao inicio() {
    real valor = 1234.56
    cadeia nome = "Roupa gamer"
    inteiro quantidade = 10
    real estoqueTotal = valor * quantidade
    escreva("Produto: " + nome)
    escreva("\nO Preço é de: R$" + valor) 
    escreva("\nTemos apenas " + quantidade + " disponiveis")
    escreva("\nTemos um total de R$" + estoqueTotal + " em mercadorias exclusivas")
    
  }
}
