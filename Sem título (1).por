programa {
  funcao inicio() {
    real um, dois
    cadeia coisa,dividam,multi,sub,soma

    escreva("Digite dois números: ")
    leia(um)
    leia(dois)
    dividam = um / dois
    multi = um * dois
    sub = um - dois
    soma = um + dois
    escreva("Você quer que eles se dividam, multipliquem, somem, subtraim?")
    se(coisa == soma){
      escreva("")
    }


  }
}
