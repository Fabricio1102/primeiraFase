programa {
  funcao inicio() {
    // entendimento do problema
    // calcular o horario de retorno do recreio
    // infos e variaveis
    inteiro hora, minuto
    // entrada de dados
    escreva("Hora do começo: ")
    leia(hora)
    escreva("minuto do começo: ")
    leia(minuto)
    // processamento
    minuto = minuto + 20
    // saida
    escreva("Recrieo termina ")
    escreva(hora)
    escreva(" : ")
    escreva(minuto)
    escreva("\nO que acontece com quem chega depois do horário? ")
  }
}
